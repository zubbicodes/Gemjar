MFA_RECOVERY_PEPPER=replace-with-recovery-code-pepper
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
MINTSOFT_BASE_URL=
MINTSOFT_API_KEY=
