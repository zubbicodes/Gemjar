generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserKind {
  CONSUMER
  B2B
  AGENT
  ADMIN
}

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrganizationRole {
  OWNER
  BUYER
  VIEWER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum Channel {
  B2C
  B2B
  SALES_AGENT
  ADMIN
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum FulfilmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum RequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum IntegrationStatus {
  DISABLED
  HEALTHY
  DEGRADED
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYING
  FAILED
  DEAD_LETTER
}

enum CartStatus {
  ACTIVE
  DRAFT
  CONVERTED
  ABANDONED
}

model User {
  id              String                   @id @default(cuid())
  email           String                   @unique
  passwordHash    String
  firstName       String
  lastName        String
  kind            UserKind
  emailVerifiedAt DateTime?
  mfaRequired     Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  sessions        Session[]
  mfaFactors      MfaFactor[]
  securityTokens  SecurityToken[]
  memberships     OrganizationMembership[]
  roles           UserRole[]
  agent           SalesAgent?
  addresses       Address[]
  ordersCreated   Order[]                  @relation("OrderCreator")
  customerOrders  Order[]                  @relation("OrderCustomer")
  carts           Cart[]
  auditLogs       AuditLog[]
  favourites      Favourite[]
  notifications   Notification[]
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  ipHash      String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model MfaFactor {
  id              String            @id @default(cuid())
  userId          String
  type            String            @default("TOTP")
  secretEncrypted String
  verifiedAt      DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes   MfaRecoveryCode[]

  @@index([userId, verifiedAt])
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  factorId  String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  factor    MfaFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)

  @@index([factorId, usedAt])
}

model SecurityToken {
  id        String    @id @default(cuid())
  userId    String
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id       String           @id @default(cuid())
  resource String
  action   String
  roles    RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Organization {
  id                  String                      @id @default(cuid())
  name                String
  status              OrganizationStatus          @default(PENDING)
  accountNumber       String?                     @unique
  paymentTermsDays    Int                         @default(0)
  poRequired          Boolean                     @default(false)
  creditLimitMinor    Int?
  vatDisplay          String                      @default("EXCLUSIVE")
  catalogueRestricted Boolean                     @default(false)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  memberships         OrganizationMembership[]
  addresses           Address[]
  customerPrices      CustomerPrice[]
  agentAssignments    AgentCustomerAssignment[]
  orders              Order[]
  carts               Cart[]
  catalogueAccess     OrganizationProductAccess[]
}

model OrganizationMembership {
  userId         String
  organizationId String
  role           OrganizationRole
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
}

model Address {
  id             String        @id @default(cuid())
  userId         String?
  organizationId String?
  label          String
  recipient      String
  line1          String
  line2          String?
  city           String
  county         String?
  postcode       String
  countryCode    String        @default("GB")
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SalesAgent {
  id          String                    @id @default(cuid())
  userId      String                    @unique
  code        String                    @unique
  active      Boolean                   @default(true)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments AgentCustomerAssignment[]
  orders      Order[]
  carts       Cart[]
}

model AgentCustomerAssignment {
  id             String       @id @default(cuid())
  agentId        String
  organizationId String
  active         Boolean      @default(true)
  assignedAt     DateTime     @default(now())
  unassignedAt   DateTime?
  agent          SalesAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([agentId, organizationId])
}

model Category {
  id       String            @id @default(cuid())
  name     String
  slug     String            @unique
  parentId String?
  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]
}

model Product {
  id                 String                      @id @default(cuid())
  name               String
  slug               String                      @unique
  description        String
  status             ProductStatus               @default(ACTIVE)
  b2cVisible         Boolean                     @default(true)
  b2bVisible         Boolean                     @default(true)
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  deletedAt          DateTime?
  variants           ProductVariant[]
  categories         ProductCategory[]
  media              ProductMedia[]
  organizationAccess OrganizationProductAccess[]
  favourites         Favourite[]

  @@index([deletedAt])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model OrganizationProductAccess {
  organizationId String
  productId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([organizationId, productId])
  @@index([productId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductVariant {
  id               String              @id @default(cuid())
  productId        String
  sku              String              @unique
  name             String?
  retailPriceMinor Int
  b2bPriceMinor    Int?
  vatRateBasis     Int                 @default(2000)
  moq              Int                 @default(1)
  packMultiple     Int                 @default(1)
  active           Boolean             @default(true)
  attributes       Json                @default("{}")
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockSnapshots   StockSnapshot[]
  customerPrices   CustomerPrice[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  externalRefs     ExternalReference[]
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CustomerPrice {
  id             String         @id @default(cuid())
  organizationId String
  variantId      String
  minQuantity    Int            @default(1)
  unitPriceMinor Int
  effectiveFrom  DateTime       @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([organizationId, variantId, minQuantity])
}

model PricingHistory {
  id             String    @id @default(cuid())
  organizationId String?
  variantId      String
  rule           String
  unitPriceMinor Int
  minQuantity    Int       @default(1)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  changedById    String?
  createdAt      DateTime  @default(now())

  @@index([organizationId, variantId, createdAt])
}

model StockSnapshot {
  id         String         @id @default(cuid())
  variantId  String
  available  Int
  capturedAt DateTime
  provider   String         @default("MINTSOFT")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, capturedAt])
}

model Cart {
  id             String        @id @default(cuid())
  anonymousToken String?       @unique
  userId         String?
  organizationId String?
  agentId        String?
  channel        Channel
  status         CartStatus    @default(ACTIVE)
  name           String?
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent          SalesAgent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([userId, channel, status, updatedAt])
  @@index([organizationId, channel, status, updatedAt])
  @@index([agentId, channel, status, updatedAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id                       String              @id @default(cuid())
  number                   String              @unique
  idempotencyKey           String              @unique
  source                   Channel
  status                   OrderStatus         @default(SUBMITTED)
  paymentStatus            PaymentStatus       @default(UNPAID)
  fulfilmentStatus         FulfilmentStatus    @default(UNFULFILLED)
  stockConfirmationPending Boolean             @default(false)
  confirmationTokenHash    String?             @unique
  userId                   String?
  organizationId           String?
  agentId                  String?
  createdById              String?
  email                    String
  currency                 String              @default("GBP")
  subtotalMinor            Int
  vatMinor                 Int
  shippingMinor            Int                 @default(0)
  deliveryMethodCode       String?
  deliveryMethodName       String?
  totalMinor               Int
  billingAddress           Json
  deliveryAddress          Json
  purchaseOrder            String?
  notes                    String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  organization             Organization?       @relation(fields: [organizationId], references: [id])
  agent                    SalesAgent?         @relation(fields: [agentId], references: [id])
  customer                 User?               @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)
  createdBy                User?               @relation("OrderCreator", fields: [createdById], references: [id])
  items                    OrderItem[]
  events                   OrderStatusEvent[]
  payments                 Payment[]
  shipments                Shipment[]
  requests                 ServiceRequest[]
  invoice                  InvoiceReference?
  externalRefs             ExternalReference[]

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  variantId      String?
  skuSnapshot    String
  nameSnapshot   String
  quantity       Int
  unitPriceMinor Int
  vatMinor       Int
  totalMinor     Int
  pricingRule    String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  shipmentItems  ShipmentItem[]
  returnItems    ReturnItem[]
}

model OrderStatusEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  provider       String
  externalId     String?       @unique
  idempotencyKey String        @unique @default(cuid())
  status         PaymentStatus
  amountMinor    Int
  failureCode    String?
  failureMessage String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds        Refund[]
}

model DeliveryMethod {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  description        String
  priceMinor         Int
  freeThresholdMinor Int?
  estimatedDaysMin   Int
  estimatedDaysMax   Int
  active             Boolean  @default(true)
  position           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, position])
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  externalId  String?  @unique
  idempotencyKey String @unique
  amountMinor Int
  reason      String
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Shipment {
  id             String          @id @default(cuid())
  orderId        String
  status         ShipmentStatus  @default(PENDING)
  carrier        String?
  trackingNumber String?
  externalId     String?         @unique
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items          ShipmentItem[]
  trackingEvents TrackingEvent[]

  @@index([orderId, createdAt])
}

model ShipmentItem {
  shipmentId  String
  orderItemId String
  quantity    Int
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  @@id([shipmentId, orderItemId])
}

model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String
  detail     String?
  occurredAt DateTime
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model ServiceRequest {
  id        String        @id @default(cuid())
  orderId   String
  type      String
  status    RequestStatus @default(REQUESTED)
  reason    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     ReturnItem[]
}

model ReturnItem {
  requestId   String
  orderItemId String
  quantity    Int
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id])

  @@id([requestId, orderItemId])
}

model InvoiceReference {
  id          String   @id @default(cuid())
  orderId     String   @unique
  number      String   @unique
  totalMinor  Int
  issuedAt    DateTime
  documentKey String?
  externalId  String?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model IntegrationConnection {
  id            String            @id @default(cuid())
  provider      String            @unique
  status        IntegrationStatus @default(DISABLED)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  cursor        String?
  configuration Json              @default("{}")
  jobs          IntegrationJob[]
}

model IntegrationJob {
  id             String                @id @default(cuid())
  connectionId   String
  type           String
  status         JobStatus             @default(PENDING)
  correlationId  String
  idempotencyKey String                @unique
  payload        Json
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id])

  @@index([status, nextAttemptAt])
}

model ExternalReference {
  id         String          @id @default(cuid())
  provider   String
  entityType String
  externalId String
  variantId  String?
  orderId    String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, entityType, externalId])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  aggregate   String
  aggregateId String
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([aggregate, aggregateId, type])
  @@index([processedAt, createdAt])
}

model ImportJob {
  id             String    @id @default(cuid())
  type           String
  status         JobStatus @default(PENDING)
  objectKey      String
  idempotencyKey String    @unique
  totalRows      Int       @default(0)
  validRows      Int       @default(0)
  invalidRows    Int       @default(0)
  errors         Json      @default("[]")
  payload        Json      @default("[]")
  committedAt    DateTime?
  createdAt      DateTime  @default(now())
}

model ExportJob {
  id         String    @id @default(cuid())
  type       String
  status     JobStatus @default(PENDING)
  objectKey  String
  content    String
  rowCount   Int       @default(0)
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  event      String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
